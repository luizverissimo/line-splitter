{
  "name": "@line-splitter/desktop",
  "productName": "Line Splitter",
  "version": "0.1.0",
  "description": "Separa um instrumento de uma música, localmente.",
  "private": true,
  "type": "module",
  "main": "out/main.cjs",
  "scripts": {
    "build": "pnpm --filter @line-splitter/web build && node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --allowOnly=false",
    "bench": "vitest run --config vitest.bench.config.ts && node -e \"process.stdout.write(require('node:fs').readFileSync('../../fixtures/benchmark.md','utf8'))\"",
    "dist:linux": "pnpm build && electron-builder --linux AppImage deb --publish never",
    "dist:win": "pnpm build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0"
  },
  "devDependencies": {
    "@line-splitter/shared": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "electron": "^45.4.1",
    "electron-builder": "26.0.12",
    "esbuild": "^0.28.2",
    "zod": "^4.6.7"
  },
  "build": {
    "appId": "br.local.linesplitter",
    "productName": "Line Splitter",
    "executableName": "line-splitter",
    "directories": {
      "buildResources": "build",
      "output": "../../release"
    },
    "files": [
      "out/**",
      "!out/**/*.map",
      "package.json",
      "!node_modules/better-sqlite3/binding.gyp",
      "!node_modules/better-sqlite3/deps/**",
      "!node_modules/better-sqlite3/src/**",
      "!node_modules/better-sqlite3/build/**"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "renderer"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/prebuilds/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Audio",
      "synopsis": "Separa um instrumento de uma música",
      "desktop": {
        "entry": {
          "Name": "Line Splitter",
          "Comment": "Separa um instrumento de uma música em dois MP3",
          "StartupWMClass": "Line Splitter"
        }
      },
      "maintainer": "Luiz Verissimo",
      "vendor": "Luiz Verissimo"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Line Splitter",
      "artifactName": "Line-Splitter-Setup-${version}.${ext}"
    },
    "npmRebuild": false,
    "deb": {
      "depends": [
        "ffmpeg",
        "python3",
        "python3-venv"
      ],
      "artifactName": "line-splitter_${version}_${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "Line-Splitter-${version}-${arch}.${ext}"
    }
  },
  "homepage": "https://github.com/luizverissimo/line-splitter",
  "author": {
    "name": "Luiz Verissimo"
  }
}
