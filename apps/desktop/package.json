{
  "name": "@line-splitter/desktop",
  "productName": "Line Splitter",
  "version": "0.1.0",
  "description": "Separa um instrumento de uma música, localmente.",
  "private": true,
  "type": "module",
  "main": "out/main.cjs",
  "scripts": {
    "build": "pnpm --filter @line-splitter/web build && node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --allowOnly=false",
    "bench": "vitest run --config vitest.bench.config.ts && node -e \"process.stdout.write(require('node:fs').readFileSync('../../fixtures/benchmark.md','utf8'))\""
  },
  "dependencies": {
    "@line-splitter/shared": "workspace:*",
    "better-sqlite3": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "electron": "^45.4.1",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "br.local.linesplitter",
    "productName": "Line Splitter",
    "executableName": "line-splitter",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "renderer"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Audio",
      "synopsis": "Separa um instrumento de uma música",
      "desktop": {
        "entry": {
          "Name": "Line Splitter",
          "Comment": "Separa um instrumento de uma música em dois MP3",
          "StartupWMClass": "Line Splitter"
        }
      }
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Line Splitter"
    }
  }
}
