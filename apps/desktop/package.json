{
  "name": "@line-splitter/desktop",
  "productName": "Line Splitter",
  "version": "0.1.0",
  "description": "Separa um instrumento de uma música, localmente.",
  "private": true,
  "type": "module",
  "main": "out/main.cjs",
  "scripts": {
    "build": "pnpm --filter @line-splitter/web build && node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --allowOnly=false"
  },
  "dependencies": {
    "@line-splitter/shared": "workspace:*",
    "better-sqlite3": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "electron": "^45.4.1",
    "esbuild": "^0.28.2"
  }
}
