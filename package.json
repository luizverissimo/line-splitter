{
  "name": "line-splitter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --allowOnly=false",
    "antimock": "node .claude/scripts/anti-mock.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm antimock",
    "dev": "node scripts/dev.mjs",
    "test:e2e": "pnpm --filter @line-splitter/desktop build && playwright test",
    "fixtures": "node scripts/fixtures.mjs --long",
    "bench": "pnpm --filter @line-splitter/desktop bench",
    "dist:linux": "pnpm --filter @line-splitter/desktop dist:linux",
    "dist:win": "pnpm --filter @line-splitter/desktop dist:win",
    "smoke:linux": "playwright test --config playwright.pacote.config.ts",
    "quality": "node scripts/quality.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "better-sqlite3"
    ],
    "overrides": {
      "@types/node": "^24"
    }
  }
}
